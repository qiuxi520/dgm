# 复制为 .env 后填写密钥。所有 DGM 模型调用统一使用以下配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 思考模式支持工具调用；项目会保留并回传 reasoning_content。
DEEPSEEK_THINKING=enabled
DEEPSEEK_MAX_TOKENS=8192

# Linux 上若代理监听 localhost，构建步骤需要宿主机网络。
# 不填时会根据 HTTP_PROXY / HTTPS_PROXY 的地址自动选择。
SWE_BUILD_NETWORK=
# 需要代理时按自己的端口填写，宿主机已有环境变量优先。
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
